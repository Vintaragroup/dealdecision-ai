# API base URL the web app calls at runtime.
# Local dev (docker-compose.dev.yml): http://localhost:9001
# Prod (Render): https://<your-api-service>.onrender.com
VITE_API_BASE_URL=http://localhost:9001

# Contact email shown on access-denied and invite-only pages.
# Defaults to access@dealdecision.ai if not set.
VITE_CONTACT_EMAIL=access@dealdecision.ai

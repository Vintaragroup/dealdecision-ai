# Production-mirror local environment template
#
# Goal: mirror Render production *shape* (same keys, same images), but run locally.
# Copy to `.env` (gitignored) and fill in as needed.
#
# For Docker (docker-compose.prod-mirror.yml): DATABASE_URL/REDIS_URL are set inside containers.
# For HOST-run scripts (e.g. `pnpm debug:force-ocr`): set the localhost URLs below.

# --- Host-run helpers (used by scripts executed on your laptop) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:55433/dealdecision
REDIS_URL=redis://localhost:6380
VISION_BASE_URL=http://localhost:8001

# --- Auth (optional locally) ---
# Local default in docker-compose.prod-mirror.yml is DISABLE_CLERK_AUTH=1.
# Set this to 0 and provide real keys if you want auth parity.
DISABLE_CLERK_AUTH=1
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- LLM ---
OPENAI_API_KEY=

# --- Cloudflare R2 (optional locally; required if you want full rendered_pages_r2 parity) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_S3_ENDPOINT=

# --- Vision understanding (optional) ---
ENABLE_VISION_UNDERSTANDING=0
LOG_LEVEL=INFO

# --- Web (Vite) build-time env (optional) ---
# These values are baked into the web bundle at container build time.
# The app requires a publishable key; provide one if you don't have a local apps/web/.env.local.
PROD_MIRROR_VITE_API_BASE_URL=http://localhost:9001
PROD_MIRROR_VITE_BACKEND_MODE=live
PROD_MIRROR_VITE_CLERK_PUBLISHABLE_KEY=

# =============================================================================
# .env.docker.local — Docker Compose runtime environment (containers only)
#
# Copy this file to .env.docker.local (gitignored) and fill in real values.
# Injected as `env_file` into api_dev and worker_dev by docker-compose.dev.yml.
# NOT used by host-side tooling (.env.local handles that).
#
# DATABASE_URL and REDIS_URL use docker service names (not localhost).
# =============================================================================

# -------------------------
# Database / Redis (required)
# -------------------------
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/dealdecision
REDIS_URL=redis://redis:6379

# -------------------------
# API
# -------------------------
# Allow the local web container origin for CORS.
CORS_ORIGINS=http://localhost:4174

# Bypass Clerk auth in dev (set to 0 to test auth flows locally).
DISABLE_CLERK_AUTH=1

# Admin token for destructive operations. Must match VITE_ADMIN_TOKEN in web.
# ADMIN_TOKEN=

# -------------------------
# Auth (Clerk) — optional when DISABLE_CLERK_AUTH=1
# -------------------------
# CLERK_JWKS_URL=https://<your-clerk-frontend-api>/.well-known/jwks.json
# CLERK_SECRET_KEY=

# -------------------------
# LLM / AI
# -------------------------
OPENAI_API_KEY=

# -------------------------
# Storage — leave unset for local filesystem; set all R2_* for Cloudflare R2
# -------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
# R2_S3_ENDPOINT=

# -------------------------
# Feature flags
# -------------------------
DETERMINISTIC_SCORE_V1_ENABLED=true
# PDF_EXTRACT_MODE=v2_shadow
# ENABLE_VISUAL_EXTRACTION=1
# FUNDABILITY_SHADOW_MODE=1
# FUNDABILITY_SOFT_CAPS=1
# FUNDABILITY_HARD_GATES=0

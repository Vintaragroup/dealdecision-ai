# dependencies
node_modules/
.pnp.cjs
.pnp.loader.mjs

# builds
/dist/
/build/
/.turbo/

# env (ignore at any depth)
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.*.example

# logs and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
artifacts/
scripts/experimental/

# local dev artifacts (do not commit)
apps/api/tmp_*.cjs
apps/worker/*.traineddata
/services/

# Timestamped audit run outputs (generated by audit:portfolio:coverage:*:out and
# coverage:audit:3deals scripts). Only the canonical coverage_baseline.json is
# tracked (kept by the !apps/worker/tmp/coverage_baseline.json allowlist below).
apps/worker/tmp/coverage-baseline-*.json
apps/worker/tmp/coverage-current-*.json
apps/worker/tmp/coverage-3deals*
# Implied capital / UoF verification run outputs (machine-readable results and
# human-readable summaries written by verify:implied-capital:* scripts).
apps/worker/tmp/implied-capital-verify-*.json
apps/worker/tmp/implied-capital-verify-*.md
# Ephemeral 3-deal audit list (generated locally by regen:portfolio:3deals;
# not canonical — use tmp/audit_deals.json for the full portfolio baseline).
tmp/audit_3deals.json

# internal documentation
# Keep the bulk of docs ignored (trace runs can be large), but allow committing
# curated human-readable docs.
docs/**

# Curated top-level docs
!docs/scoring-and-evidence.md
!docs/runbook-debugging.md

# Curated Active docs (human-readable only)
!docs/Active/

# Keep Active ignored by default; allowlist only text docs
docs/Active/**
!docs/Active/**/*.md
!docs/Active/**/*.mdc
!docs/Active/**/*.mdx
!docs/Active/**/*.txt

# Never track binaries even if they land in Active
docs/Active/**/*.pdf
docs/Active/**/*.ppt
docs/Active/**/*.pptx
docs/Active/**/*.xls
docs/Active/**/*.xlsx
docs/Active/**/*.doc
docs/Active/**/*.docx
docs/Active/**/*.png
docs/Active/**/*.jpg
docs/Active/**/*.jpeg
docs/Active/**/*.gif
docs/Active/**/*.webp
docs/Active/**/*.zip
docs/Active/**/*.7z

# Trace audit rollup
!docs/trace_audit/
docs/trace_audit/**
!docs/trace_audit/ROLLUP.md

# Cleanup control docs (tracked)
!docs/DOCS_CLEANUP_MANIFEST.md
!docs/DOCS_WEB_SRC_MD_MANIFEST.md
# !docs/docs_triage_table_ultra.md

# editor/os
.DS_Store
.idea/
*.iml

# local git worktrees
.worktrees/

# pnpm store
.pnpm-store/

# coverage
coverage/

# python bytecode / caches
__pycache__/
*.py[cod]
*$py.class


# package-internal docs (not curated)
packages/**/docs/.vscode/

# Python bytecode
__pycache__/
*.pyc

# giga
.giga/
AGENTS.md
CLAUDE.md
.github/copilot-instructions.md

# Fixture regression artifacts (generated)
apps/api/test/fixtures/regressions/**/*.full.report.json
apps/api/test/fixtures/regressions/runner*.log

# Fixture input decks (raw PDFs/PPTX/etc) — commit governed fixtures only
apps/api/test/fixtures/decks/**
!apps/api/test/fixtures/decks/
!apps/api/test/fixtures/decks/**/
!apps/api/test/fixtures/decks/**/*.pdf
!apps/api/test/fixtures/decks/**/*.pptx
!apps/api/test/fixtures/decks/**/*.xlsx
!apps/api/test/fixtures/decks/**/*.docx

# Allow committed regression baselines
!apps/api/test/fixtures/regressions/**/*.snapshot.json
!apps/api/test/fixtures/regressions/**/*.meta.json
!apps/api/test/fixtures/regressions/fixture-summary.json
!apps/api/test/fixtures/regressions/VERIFICATION_REPORT.md
# local debug reports
DEBUG_FACT_EVIDENCE_TRACE_QREDIBLE*.md
scripts/overview_runtime_vs_truth_table_diff.md
verification_e2e_cinco_analysis_*.md
apps/worker/tmp/
tmp/
# Allow git to traverse apps/worker/tmp/ for specific committed fixtures.
# git won't descend into an excluded directory, so we un-ignore the dir,
# re-ignore all its contents, then carve out the specific committed files.
#
# audit_deals.json  — canonical portfolio list for coverage audit + trend gate.
#                     Edit intentionally; never auto-generated.
# coverage_baseline.json — committed baseline snapshot for CI trend gate.
#                          Updated via the `update-coverage-baseline` workflow.
!apps/worker/tmp/
apps/worker/tmp/*
!apps/worker/tmp/audit_deals.json
!apps/worker/tmp/coverage_baseline.json

# DealDecisionAI evaluation outputs
evaluation/reports/
evaluation/*.zip
evaluation/**/*.zip
evaluation/reports/**/*.md
evaluation/run_history/
evaluation/reviews/

# DB snapshots
evaluation/db_snapshots/

# Python cache
evaluation/**/__pycache__/
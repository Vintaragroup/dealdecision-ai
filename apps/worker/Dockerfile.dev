FROM node:20
WORKDIR /app
ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

# System tools for document processing parity (dev):
# - LibreOffice: Office -> PDF conversion (`soffice`)
# - Poppler: pdfinfo/pdftoppm
# - Ghostscript: PDF compatibility
# - ImageMagick: image transforms
# - Tesseract: OCR
# - Fonts: rendering fidelity
RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		libreoffice \
		poppler-utils \
		ghostscript \
		imagemagick \
		tesseract-ocr \
		tesseract-ocr-eng \
		fonts-dejavu-core \
		fonts-liberation \
		fonts-noto-core \
	&& rm -rf /var/lib/apt/lists/*

COPY pnpm-lock.yaml package.json pnpm-workspace.yaml tsconfig.base.json ./
# Include workspace package manifests needed for worker install
COPY apps/worker/package.json apps/worker/package.json
COPY packages/contracts/ packages/contracts/
COPY packages/core/ packages/core/
RUN pnpm install --frozen-lockfile=false

# Sanity check: BullMQ must be available at worker runtime.
WORKDIR /app/apps/worker
RUN node -e 'require("bullmq"); console.log("bullmq_ok")'
WORKDIR /app

# @dealdecision/core has "main": dist/index.js; build it so runtime imports work
RUN pnpm --filter @dealdecision/core build

CMD ["pnpm", "--filter", "worker", "dev"]

# LEGACY (deprecated)
#
# This file is kept only to avoid breaking older notes.
#
# Canonical local env split is now:
# - `.env.local`        (host tooling only)
# - `.env.docker.local` (docker compose containers only)
#
# See `.env.example` for the full list of supported keys.

# --- Host-run helpers (used by scripts executed on your laptop) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:55433/dealdecision
REDIS_URL=redis://localhost:6380
VISION_BASE_URL=http://localhost:8001

# --- Auth (optional locally) ---
# Local default in docker-compose.local.yml is DISABLE_CLERK_AUTH=1.
# Set this to 0 and provide real keys if you want auth parity.
DISABLE_CLERK_AUTH=1
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- LLM ---
OPENAI_API_KEY=

# --- Cloudflare R2 (optional locally; required if you want full rendered_pages_r2 parity) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_S3_ENDPOINT=

# --- Vision understanding (optional) ---
ENABLE_VISION_UNDERSTANDING=0
LOG_LEVEL=INFO

# --- Web (Vite) build-time env (optional) ---
# These values are baked into the web bundle at container build time.
# Prefer setting `VITE_API_BASE_URL` in your normal local tooling envs.

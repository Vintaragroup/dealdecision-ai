{
  "name": "dealdecision-ai",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "debug:force-ocr": "tsx apps/worker/src/scripts/debug-force-ocr-extract-visuals.ts",
      "report:segments:audit:md": "tsx scripts/segment-classification-audit.ts",
    "report:segments:audit:all": "tsx scripts/segment-classification-audit-all.ts",
    "report:slide-titles:md": "tsx scripts/export-slide-titles-md.ts",
    "report:unknowns:hotspots": "tsx scripts/unknown-hotspots.ts",
    "report:unknowns:kb": "tsx scripts/unknown-knowledgebase.ts",
    "fixtures:verify": "tsx apps/api/scripts/fixture-verification-report.ts",
    "dev": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "style:drift": "tsx scripts/check-style-drift.ts",
    "style:drift:update": "tsx scripts/check-style-drift.ts --update",
    "local:up": "docker compose -f docker-compose.local.yml --profile prod up -d --build",
    "local:up:dev": "docker compose -f docker-compose.local.yml --profile dev up -d --build",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "local:logs": "docker compose -f docker-compose.local.yml logs -f --tail=200",

    "legacy:infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "legacy:infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:up": "node -e \"console.error('LEGACY STACK: infra/docker-compose.yml is deprecated.\\nUse: pnpm local:up (prod-shaped) or pnpm local:up:dev (hot reload).'); process.exit(1)\"",
    "infra:down": "node -e \"console.error('LEGACY STACK: infra/docker-compose.yml is deprecated.\\nUse: pnpm local:down'); process.exit(1)\"",
    "db:migrate": "pnpm --filter api db:migrate",
    "validate:llm": "tsx scripts/validate-llm-config.ts",
    "rerun:analysis:all": "tsx scripts/rerun-analysis-all-deals.ts",
    "verify:documents:all": "tsx scripts/verify-documents-all-deals.ts",
    "verify:doc-pipeline:e2e": "tsx apps/worker/src/scripts/verify-doc-pipeline-e2e.ts",
    "prove:run-analysis:dev": "tsx scripts/prove-run-analysis-parity.ts --mode dev",
    "prove:run-analysis:prodlike": "tsx scripts/prove-run-analysis-parity.ts --mode prodlike",
    "prove:run-analysis:parity": "bash scripts/prove-run-analysis-parity.sh",
    "test:prove": "node --test --import tsx scripts/__tests__/prove-run-analysis-parity.test.ts",
    "reprocess:extraction:all": "tsx scripts/reprocess-extraction-all-deals.ts",
    "rebuild:deals": "tsx scripts/rebuild-deals.ts",
    "smoke:analyst-evidence": "tsx apps/api/scripts/smoke-test-analyst-evidence.ts",
    "smoke:analyst-evidence:docker": "pnpm smoke:analyst-evidence --api-base-url http://localhost:9001",
    "refresh:extraction:analysis:all": "tsx scripts/refresh-extraction-analysis-all-deals.ts",
    "segment:audit": "tsx scripts/segment-audit-export.ts",
    "audit:unknown-segments": "tsx scripts/audit-unknown-segments.ts",
    "backfill:document-metadata": "tsx scripts/backfill-document-metadata.ts",
    "report:fundability:compare": "tsx scripts/compare-fundability-v1.ts",
    "report:fundability:compare:md": "tsx scripts/compare-fundability-v1.ts --format md --out-md docs/Active/audit/analizer-debug/fundability-compare.md",

    "audit:portfolio:baseline": "pnpm --filter worker audit:investor-insights -- --deal-list tmp/audit_deals.json --concurrency 4",
    "audit:portfolio:delta": "pnpm --filter worker audit:investor-insights -- --deal-list tmp/audit_deals.json --baseline tmp/investor-insights-audit.json --concurrency 4",
    "audit:portfolio:gate:soft": "pnpm --filter worker audit:investor-insights -- --deal-list tmp/audit_deals.json --fail-on PARSE_HAZARD,BAD_EVIDENCE_REF --max-failures 0",
    "audit:portfolio:gate:strict": "pnpm --filter worker audit:investor-insights -- --deal-list tmp/audit_deals.json --fail-on PARSE_HAZARD,BAD_EVIDENCE_REF,MISSING_DPU --max-failures 0",

    "repair:portfolio:insight-slots": "pnpm --filter worker repair:insight-slots -- --deal-list tmp/audit_deals.json --concurrency 2",
    "repair:portfolio:insight-slots:dry-run": "pnpm --filter worker repair:insight-slots -- --deal-list tmp/audit_deals.json --dry-run"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@xyflow/react": "^12.10.0",
    "cli-progress": "^3.12.0",
    "form-data": "^4.0.5",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "pngjs": "^7.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@swc/core",
      "core-js",
      "esbuild",
      "msgpackr-extract",
      "tesseract.js"
    ],
    "overrides": {
      "canvas": "npm:@napi-rs/canvas@0.1.84"
    }
  }
}


# -----------------------------------------------------------------------------
# DealDecisionAI environment variables (example)
#
# IMPORTANT:
# - Do NOT commit real secrets. Keep actual values in Render/Vercel env settings.
# - Variables prefixed with VITE_ are FRONTEND build-time vars (Vercel).
# - Non-VITE_ vars are BACKEND/WORKER vars (Render).
# -----------------------------------------------------------------------------

# ----------------------
# Backend/API (Render)
# ----------------------
NODE_ENV=development

# Render sets PORT automatically; set PORT explicitly only if your server binds to a fixed port.
# For this repo, the API commonly runs on 9000.
PORT=9000
API_PORT=9000

# Postgres (local example). In production (Render), set DATABASE_URL to Render Postgres Internal URL.
# Local docker-compose maps Postgres to host port 55432.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/dealdecision

# Redis/Valkey (local example). In production (Render), set REDIS_URL to the Render Key Value Internal URL.
REDIS_URL=redis://localhost:6379

# CORS allow-list (comma-separated). In local dev, set this to your local web origin.
# Note: the API reads CORS_ORIGINS (plural).
CORS_ORIGINS=http://localhost:5173

# ----------------------
# Frontend/Web (Vercel)
# ----------------------
# Base URL the web app uses to call the API.
# Local: http://localhost:9000
# Prod:  https://api.dealdecisionai.com (or your Render service URL)
VITE_API_BASE_URL=http://localhost:9000

# Frontend mode switch (if used by the UI)
VITE_BACKEND_MODE=live

# LLM Configuration (Week 1: OpenAI GPT-4o Phase)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_URL=https://api.openai.com/v1

# LLM Routing Configuration (optional, uses defaults if not set)
# LLM_ROUTING_FACT_EXTRACTION_MODEL=gpt-4o
# LLM_ROUTING_SYNTHESIS_MODEL=gpt-4o
# LLM_ROUTING_VALIDATION_MODEL=gpt-4o

# Cache Configuration
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_DAYS=7
LLM_CACHE_MAX_SIZE=10000

# Context Compression
LLM_COMPRESSION_ENABLED=true
LLM_COMPRESSION_AGGRESSIVE=false

# Analytics
LLM_ANALYTICS_ENABLED=true
LLM_ANALYTICS_TRACK_COSTS=true
LLM_ANALYTICS_TRACK_LATENCY=true

# Visual extraction (optional)
# When enabled, the worker will also persist per-page rendered PNGs to a stable directory
# so the vision pipeline can reliably find images.
ENABLE_VISUAL_EXTRACTION=0

# Local vision understanding (optional, zero LLM tokens)
# When ENABLE_VISION_UNDERSTANDING=1, the vision_worker will run a local CLIP-style classifier
# on very low-text pages (e.g. floor plans / diagrams) and store results under:
#   visual_extractions.structured_json.vision_understanding_v1
# IMPORTANT: turning this on requires rebuilding the vision_worker image (Docker build arg).
ENABLE_VISION_UNDERSTANDING=0
VISION_UNDERSTANDING_MIN_CONFIDENCE=0.45
# Optional model selection (defaults are fine)
# VISION_UNDERSTANDING_MODEL=ViT-B-32
# VISION_UNDERSTANDING_PRETRAINED=laion2b_s34b_b79k
# VISION_UNDERSTANDING_USE_CUDA=0
# Local (outside Docker): http://localhost:8000
# Docker Compose: http://vision_worker:8000
VISION_WORKER_URL=http://vision_worker:8000
VISION_EXTRACTOR_VERSION=vision_v1
VISION_TIMEOUT_MS=8000
VISION_MAX_PAGES=10

# Storage
# Local (outside Docker): ./uploads
# Docker Compose: /app/uploads (mounted shared volume)
UPLOAD_DIR=./uploads

# Persist rendered page images (Step 6)
# Defaults: VISUAL_PAGE_IMAGE_PERSIST inherits ENABLE_VISUAL_EXTRACTION, MAX_PAGES=50, FORMAT=png, DPI=200
VISUAL_PAGE_IMAGE_PERSIST=1
VISUAL_PAGE_IMAGE_MAX_PAGES=50
VISUAL_PAGE_IMAGE_FORMAT=png
VISUAL_PAGE_IMAGE_DPI=200
